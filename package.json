{
  "name": "css-calipers",
  "version": "0.12.1",
  "description": "Compile-time unit safety for numeric, unit-bearing CSS values via typed measurements.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slafleche/css-calipers.git"
  },
  "bugs": {
    "url": "https://github.com/slafleche/css-calipers/issues"
  },
  "homepage": "https://github.com/slafleche/css-calipers#readme",
  "author": "slafleche",
  "keywords": [
    "css",
    "units",
    "typescript",
    "measurement",
    "safety",
    "calipers",
    "type-safe",
    "css-calipers"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.12.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt",
    "RELEASING.md"
  ],
  "sideEffects": false,
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./mediaQueries": {
      "types": "./dist/esm/mediaQueries/index.d.ts",
      "import": "./dist/esm/mediaQueries/index.js",
      "require": "./dist/cjs/mediaQueries/index.js"
    },
    "./factory": {
      "types": "./dist/esm/factory.d.ts",
      "import": "./dist/esm/factory.js",
      "require": "./dist/cjs/factory.js"
    },
    "./units": {
      "types": "./dist/esm/units/index.d.ts",
      "import": "./dist/esm/units/index.js",
      "require": "./dist/cjs/units/index.js"
    },
    "./units/*": {
      "types": "./dist/esm/units/*.d.ts",
      "import": "./dist/esm/units/*.js",
      "require": "./dist/cjs/units/*.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "csstype": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vanilla-extract/css": "^1.18.0",
    "@vitest/coverage-v8": "^4.0.14",
    "eslint": "^9.39.2",
    "tsd": "^0.31.0",
    "typescript": "^5.6.3",
    "vitepress": "1.6.4",
    "vitest": "^4.0.14"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "yarn build:cjs && yarn build:esm && yarn build:examples",
    "build:cjs": "echo \"🛠️  Building CommonJS (cjs) bundle...\" && tsc -p tsconfig.build.cjs.json",
    "build:esm": "echo \"🛠️  Building ES module (esm) bundle...\" && tsc -p tsconfig.build.esm.json && node scripts/emit-esm-package.mjs",
    "build:examples": "tsc -p tsconfig.examples.json --noEmit",
    "build:test": "yarn build && yarn test",
    "build:delete": "node -e \"const { existsSync, rmSync } = require('fs'); const paths = ['dist/cjs', 'dist/esm']; for (const p of paths) { console.log('Scanning', p + '...'); if (existsSync(p)) { console.log('Found', p + ', deleting...'); rmSync(p, { recursive: true, force: true }); console.log('Deleted', p); } else { console.log(p + ' not found, skipping.'); } }\"",
    "prepublishOnly": "node -e \"if (!process.env.CSS_CALIPERS_RELEASE) { console.error('Direct npm publish is disabled; use \\\"yarn release\\\" instead.'); process.exit(1); }\" && yarn test:internal",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "test": "yarn build && yarn test:core && yarn test:ratio && yarn test:mediaQueries && yarn test:factory && yarn test:dist && yarn test:types && yarn test:tsc && yarn lint && yarn test:internal",
    "test:mediaQueries": "vitest run tests/runtime/mediaQueries/mediaQueries.src.test.ts",
    "test:mediaQueries:cjs": "vitest run tests/runtime/mediaQueries/mediaQueries.cjs.test.ts tests/runtime/api-surface/mediaQueries.api-surface.cjs.test.ts",
    "test:mediaQueries:esm": "vitest run tests/runtime/mediaQueries/mediaQueries.esm.test.ts tests/runtime/api-surface/mediaQueries.api-surface.esm.test.ts",
    "test:mediaQueries:dist": "yarn test:mediaQueries:cjs && yarn test:mediaQueries:esm",
    "test:core": "vitest run tests/runtime/core/core.src.test.ts",
    "test:ratio": "vitest run tests/runtime/ratio/ratio.src.test.ts",
    "test:core:cjs": "vitest run tests/runtime/core/core.cjs.test.ts tests/runtime/api-surface/api-surface.cjs.test.ts",
    "test:core:esm": "vitest run tests/runtime/core/core.esm.test.ts tests/runtime/api-surface/api-surface.esm.test.ts",
    "test:core:dist": "yarn test:core:cjs && yarn test:core:esm",
    "lint": "eslint . --max-warnings=0",
    "test:lint": "yarn lint",
    "test:types": "echo \"\n 🧪 Starting tsd type checks...\n\" && tsd --files tests/types/**/*.test-d.ts && echo \"✅ tsd type checks passed!\n\"",
    "test:tsc": "tsc -p tsconfig.json --noEmit",
    "test:dist": "yarn test:core:dist && yarn test:mediaQueries:dist && yarn test:factory:dist",
    "test:factory": "vitest run tests/runtime/factory/factory.src.test.ts",
    "test:factory:cjs": "vitest run tests/runtime/factory/factory.cjs.test.ts tests/runtime/api-surface/factory.api-surface.cjs.test.ts",
    "test:factory:esm": "vitest run tests/runtime/factory/factory.esm.test.ts tests/runtime/api-surface/factory.api-surface.esm.test.ts",
    "test:factory:dist": "yarn test:factory:cjs && yarn test:factory:esm",
    "test:internal": "tsc -p tsconfig.internal.json --noEmit"
  }
}
